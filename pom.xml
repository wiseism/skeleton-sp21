<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.ibqo</groupId>
    <artifactId>skeleton-sp21-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>lab1</module>
        <module>lab2</module>
        <module>lab2setup</module>
        <module>lab3</module>
        <module>lab4</module>
        <module>lab6</module>
        <module>lab7</module>
        <module>lab8</module>
        <module>proj0</module>
        <module>proj1</module>
        <module>proj1ec</module>
        <module>proj2</module>
        <module>proj3</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cs61b.lib.dir>${maven.multiModuleProjectDirectory}/library-sp21/javalib</cs61b.lib.dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>algs4</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/algs4.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>stdlib-package</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/stdlib-package.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>stdlib</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/stdlib.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>ucb</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/ucb.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/junit-4.12.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>hamcrest-core</artifactId>
            <version>1.3</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/hamcrest-core-1.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>cs61b.local</groupId>
            <artifactId>jh61b</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${cs61b.lib.dir}/jh61b.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.1.2</version>
                    <dependencies>
                        <dependency>
                            <groupId>org.apache.maven.surefire</groupId>
                            <artifactId>surefire-junit4</artifactId>
                            <version>3.1.2</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <failIfNoTests>false</failIfNoTests>
                        <useModulePath>false</useModulePath>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
